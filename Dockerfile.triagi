# Triagi minimal patch over upstream Postiz image.
# Removes r_basicprofile scope (deprecated by LinkedIn) from any file that
# still references it, so OAuth connect stops failing with NotEnoughScopes
# (upstream issue gitroomhq/postiz-app#1197).
FROM ghcr.io/gitroomhq/postiz-app:v2.11.3

# Find every file that mentions r_basicprofile and strip those lines.
RUN set -eux; \
    matches="$(grep -RIlF 'r_basicprofile' /app 2>/dev/null || true)"; \
    if [ -z "$matches" ]; then echo "nothing to patch"; else \
        echo "patching files:"; echo "$matches"; \
        echo "$matches" | xargs sed -i "/r_basicprofile/d"; \
    fi; \
    remaining="$(grep -RIlF 'r_basicprofile' /app 2>/dev/null || true)"; \
    if [ -n "$remaining" ]; then \
        echo "ERROR: r_basicprofile still present in:"; echo "$remaining"; exit 1; \
    fi; \
    echo "Patch OK: r_basicprofile removed"
