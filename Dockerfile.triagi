# Triagi minimal patch over upstream Postiz image.
# Rewrite LinkedIn scopes to the minimum subset the Triagi LinkedIn app
# actually has approved (Sign In OpenID + Share on LinkedIn).
# Removes dead upstream scope `r_basicprofile` (legacy product LinkedIn
# discontinued) and the organization scopes (require Marketing Developer
# Platform which Triagi does not yet have approved).
FROM ghcr.io/gitroomhq/postiz-app:v2.11.3

COPY triagi-patch.js /tmp/triagi-patch.js
RUN node /tmp/triagi-patch.js && rm /tmp/triagi-patch.js
